NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server only. Never use a NEXT_PUBLIC_ prefix for Gemini or the trusted writer.
GEMINI_API_KEY=
CIRRA_MODEL_FAST=gemini-3.1-flash-lite
CIRRA_MODEL_SMART=gemini-3.5-flash-lite
# Shared database limiter is required for production. Memory is for local preview only.
CIRRA_LIMIT_STORE=database
# Technical safety ceilings, not Free/Premium entitlements.
CIRRA_REQUESTS_PER_MINUTE=6
CIRRA_REQUESTS_PER_DAY=60
CIRRA_CONCURRENT_REQUESTS=1
CIRRA_TIMEOUT_MS=25000
CIRRA_MAX_OUTPUT_TOKENS=1800
CIRRA_MAX_CONTEXT_CHARS=24000
# Optional server override: FAST or SMART; leave empty for deterministic routing.
CIRRA_MODEL_OVERRIDE=
