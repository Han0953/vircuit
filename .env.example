NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server only. Never use a NEXT_PUBLIC_ prefix for Gemini or the trusted writer.
GEMINI_API_KEY=
CIRRA_MODEL_FAST=gemini-3.1-flash-lite
CIRRA_MODEL_SMART=gemini-3.5-flash-lite

# Limiter: database (production with Supabase RPC) or memory (development/preview)
CIRRA_LIMIT_STORE=memory
# Set to 1 when using memory limiter in production or preview environments
CIRRA_LOCAL_PREVIEW=1

# Technical safety ceilings
CIRRA_REQUESTS_PER_MINUTE=6
CIRRA_REQUESTS_PER_DAY=60
CIRRA_CONCURRENT_REQUESTS=1
CIRRA_TIMEOUT_MS=30000
CIRRA_MAX_OUTPUT_TOKENS=1800
CIRRA_MAX_CONTEXT_CHARS=24000

# Optional server override: FAST or SMART (SMART recommended for fast responses)
CIRRA_MODEL_OVERRIDE=SMART
